# Server Configuration
PORT=3001
NODE_ENV=development

# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://postgres:password@localhost:5432/workflowx"

# Authentication Secrets
AUTH_ACCESS_TOKEN_SECRET="replace-with-a-secure-random-32-byte-secret"
AUTH_REFRESH_TOKEN_SECRET="replace-with-a-secure-random-32-byte-secret"
ADMIN_SECRET_KEY="replace-with-admin-master-key"

# Email Verification (Option 1 - Resend HTTPS API, Recommended for Cloud/Render)
# Get a free key at https://resend.com (bypasses cloud SMTP port blocking)
RESEND_API_KEY="re_your_api_key_here"
MAIL_FROM="WorkFlowX <onboarding@resend.dev>"

# Email Verification (Option 2 - Direct Gmail SMTP, For Local Dev)
# For Gmail, generate a 16-character App Password at:
# https://myaccount.google.com/apppasswords
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Optional Redis Cache (falls back to memory if empty)
# REDIS_URL="redis://localhost:6379"
